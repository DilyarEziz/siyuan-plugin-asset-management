{
  "$schema": "https://opencode.ai/config.json",
  // 项目层配置：随仓库分发，工作树检出即自带。
  // 双端路径双写：Mac 与 Windows 各一条，本机不存在的一条自动失效，互不影响。
  // 领域技能桥（SiyuanDev 领域层）：siyuan-plugin-dev / siyuan-api-reference /
  // siyuan-internals / siyuan-plugin-publishing / siyuan-plugin-mobile
  "skills": [
    "/Users/dilyar/Documents/Workspace/workspace-agents/siyuandev/skills",
    "D:/Workspace/workspace-agents/siyuandev/skills"
  ],
  // 领域知识引用：思源内核源码（大体积参考，永留领域层，只引用不入库）
  "references": {
    "siyuan-source": {
      "path": "/Users/dilyar/Documents/Workspace/SiyuanDev/参考/siyuan-master",
      "description": "思源 v3.8 内核源码参考。涉及 Plugin API、内核行为、MCP server、移动端行为时查阅"
    },
    "siyuan-source-win": {
      "path": "D:/Workspace/SiyuanDev/参考/siyuan-master",
      "description": "（Windows 端）思源 v3.8 内核源码参考"
    }
  },
  "permissions": [
    // 领域资产与参考资料只读：放行外部目录 + 允许读 + 禁止写（主本只能领域层改）
    { "action": "external_directory", "resource": "/Users/dilyar/Documents/Workspace/workspace-agents/*", "effect": "allow" },
    { "action": "external_directory", "resource": "D:/Workspace/workspace-agents/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/dilyar/Documents/Workspace/SiyuanDev/*", "effect": "allow" },
    { "action": "external_directory", "resource": "D:/Workspace/SiyuanDev/*", "effect": "allow" },
    { "action": "read", "resource": "/Users/dilyar/Documents/Workspace/workspace-agents/*", "effect": "allow" },
    { "action": "read", "resource": "D:/Workspace/workspace-agents/*", "effect": "allow" },
    { "action": "read", "resource": "/Users/dilyar/Documents/Workspace/SiyuanDev/*", "effect": "allow" },
    { "action": "read", "resource": "D:/Workspace/SiyuanDev/*", "effect": "allow" },
    { "action": "edit", "resource": "/Users/dilyar/Documents/Workspace/workspace-agents/*", "effect": "deny" },
    { "action": "edit", "resource": "D:/Workspace/workspace-agents/*", "effect": "deny" },
    { "action": "edit", "resource": "/Users/dilyar/Documents/Workspace/SiyuanDev/*", "effect": "deny" },
    { "action": "edit", "resource": "D:/Workspace/SiyuanDev/*", "effect": "deny" }
  ]
}
